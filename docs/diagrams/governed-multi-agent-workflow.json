  "cards": [
    {
      "dot": "cyan",
      "title": "Deterministic Supervisor",
      "items": [
        "State machine drives every phase — never an autonomous LLM",
        "Run state persisted to .sync/runtime/supervisor/run-*.yaml",
        "Workers are role-bound LLM backends (codex, gemini, gemma, local-llm)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Governed Harness Turn",
      "items": [
        "Context assembly is fail-closed against the contract scope",
        "Model tools write to a scratch workspace, never the live tree",
        "Schema validation + staged stackmind validate + PLAT-03 lock",
        "Write-back only after all 6 verification dimensions pass"
      ]
    },
    {
      "dot": "rose",
      "title": "Bounded Recovery",
      "items": [
        "Worker rework and authoring repairs capped at 2 rounds",
        "Blocked work needs a machine-readable architect decision",
        "escalate_human returns control to the CEO"
      ]
    },
    {
      "dot": "violet",
      "title": "Learning Loop (LEARN-01)",
      "items": [
        "Experiences captured only from fully verified turns",
        "Clusters need ≥ 3 verified episodes before distillation",
        "3-stage verification gates every skill promotion"
      ]
    }
  ]
