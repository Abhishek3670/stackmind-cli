{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StackMind Symbol Registry Record",
  "type": "object",
  "required": [
    "node_id",
    "kind",
    "birth_key",
    "birth_digest",
    "current",
    "aliases",
    "previous_names",
    "status",
    "history"
  ],
  "properties": {
    "node_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9a-f]{16}$"
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "birth_key": {
      "type": "string",
      "minLength": 1
    },
    "birth_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "current": {
      "type": "object",
      "required": [
        "path",
        "qualified_name"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "qualified_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "previous_names": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "obsolete"
      ]
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rev",
          "event"
        ],
        "properties": {
          "rev": {
            "type": "integer",
            "minimum": 0
          },
          "event": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "active"
          }
        }
      },
      "then": {
        "properties": {
          "current": {
            "required": [
              "path",
              "qualified_name"
            ]
          }
        }
      }
    }
  ]
}
