{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StackMind Knowledge AI Block",
  "type": "object",
  "properties": {
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "embedding_dimensions": {
      "type": "integer",
      "minimum": 0
    },
    "embedding_model": {
      "type": "string",
      "minLength": 1
    },
    "enriched_at": {
      "type": "string",
      "minLength": 1
    },
    "enriched_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "privacy_mode": {
      "type": "string",
      "enum": ["full", "signatures", "local", "off"]
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": ["string", "null"]
    },
    "risk": {
      "type": ["string", "null"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "minProperties": 1
      },
      "then": {
        "required": [
          "confidence",
          "enriched_at",
          "enriched_hash",
          "model",
          "privacy_mode",
          "prompt_version",
          "summary"
        ]
      }
    }
  ]
}
