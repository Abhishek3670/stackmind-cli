{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "stackmind Work Order",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "status",
    "priority",
    "assigned_agents",
    "dependencies"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^WO-[0-9]{3}$"
    },
    "type": {
      "type": "string",
      "enum": [
        "PHASE",
        "FEATURE",
        "BUGFIX",
        "HOTFIX",
        "REFACTOR",
        "RESEARCH",
        "AUDIT",
        "VALIDATION",
        "FIX"
      ]
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "READY",
        "PENDING",
        "ACTIVE",
        "BLOCKED",
        "COMPLETE",
        "COMPLETED"
      ]
    },
    "priority": {
      "type": "string",
      "pattern": "^P[0-3]$"
    },
    "assigned_agents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affected_services": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "api_changes": {
      "type": "boolean"
    },
    "db_migration": {
      "type": "boolean"
    },
    "frontend_changes": {
      "type": "boolean"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": true
    },
    "release": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "commit": {
              "type": "string"
            },
            "branch": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "released_by": {
              "type": "string"
            },
            "released_date": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "released": {
      "type": "boolean"
    },
    "release_tag": {
      "type": "string"
    },
    "release_commit": {
      "type": "string"
    },
    "blocked_reason": {
      "type": "string"
    },
    "reproduction_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "root_cause": {
      "type": "string"
    },
    "fix_verified": {
      "type": "boolean"
    },
    "phase_number": {
      "type": [
        "integer",
        "null"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": true
    },
    "quality_gates": {
      "type": "object",
      "additionalProperties": true
    },
    "deliverable": {
      "type": "object",
      "required": [
        "type",
        "description"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "code",
            "doc",
            "config",
            "module"
          ]
        },
        "path": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "plan_ref": {
      "type": "string"
    },
    "created": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\{\\{[A-Z0-9_]+\\}\\}$"
        },
        {
          "type": "string"
        }
      ]
    },
    "updated": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\{\\{[A-Z0-9_]+\\}\\}$"
        },
        {
          "type": "string"
        }
      ]
    },
    "completed_at": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\{\\{[A-Z0-9_]+\\}\\}$"
        },
        {
          "type": "string"
        }
      ]
    },
    "unblocked": {
      "type": "string"
    },
    "unblocked_reason": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files_created": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gate_conditions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "condition": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            },
            "required": [
              "condition",
              "status"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "milestones": {
      "type": "object",
      "patternProperties": {
        "^M[0-9]+$": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "assigned": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "status": {
              "type": "string",
              "enum": [
                "READY",
                "PENDING",
                "ACTIVE",
                "BLOCKED",
                "COMPLETE",
                "COMPLETED"
              ]
            },
            "completed_at": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^\\{\\{[A-Z0-9_]+\\}\\}$"
                },
                {
                  "type": "string"
                }
              ]
            },
            "depends_on": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": {
              "type": "string"
            },
            "tasks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "acceptance": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "gate": {
              "type": "boolean"
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "dependency_graph": {
      "type": "string"
    },
    "agent_assignments": {
      "type": "object",
      "additionalProperties": true
    },
    "log": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "date": {
                "type": "string"
              },
              "agent": {
                "type": "string"
              },
              "action": {
                "type": "string"
              }
            },
            "required": [
              "date",
              "agent",
              "action"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "rework_budget": {
      "type": "integer",
      "minimum": 1,
      "default": 2
    },
    "rework_count": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "blocked_by_rework": {
      "type": "boolean",
      "default": false
    },
    "contract_ref": {
      "type": "string"
    },
    "context": {
      "type": [
        "object",
        "string",
        "array"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "deliverables": {
      "type": [
        "array",
        "object"
      ]
    },
    "instructions": {
      "type": [
        "array",
        "string"
      ]
    },
    "milestone": {
      "type": [
        "string",
        "object"
      ]
    },
    "qa_by": {
      "type": "string"
    },
    "qa_verdict": {
      "type": "string"
    }
  },
  "additionalProperties": false
}