{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "stackmind Work Order",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "status",
    "priority",
    "assigned_agents",
    "dependencies"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^WO-[0-9]{3}$"
    },
    "type": {
      "type": "string",
      "enum": [
        "PHASE",
        "FEATURE",
        "BUGFIX",
        "HOTFIX",
        "REFACTOR",
        "RESEARCH",
        "AUDIT",
        "VALIDATION",
        "FIX"
      ]
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "READY",
        "PENDING",
        "ACTIVE",
        "BLOCKED",
        "COMPLETE",
        "COMPLETED",
        "FAILED"
      ]
    },
    "priority": {
      "type": "string",
      "pattern": "^P[0-3]$"
    },
    "assigned_agents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirement_refs": {
      "type": "array",
      "description": "Stable requirement IDs from the requirements ledger that this work order addresses (e.g., ['R001', 'R002']).",
      "items": {
        "type": "string",
        "pattern": "^R[0-9]{3}$"
      }
    },
    "affected_services": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "api_changes": {
      "type": "boolean"
    },
    "db_migration": {
      "type": "boolean"
    },
    "frontend_changes": {
      "type": "boolean"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skills": {
      "type": "array",
      "description": "Procedural skills selected by the Architect for this work order",
      "items": {
        "type": "string"
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": true
    },
    "release": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "commit": {
              "type": "string"
            },
            "branch": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "released_by": {
              "type": "string"
            },
            "released_date": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "released": {
      "type": "boolean"
    },
    "release_tag": {
      "type": "string"
    },
    "release_commit": {
      "type": "string"
    },
    "blocked_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "reproduction_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "root_cause": {
      "type": "string"
    },
    "fix_verified": {
      "type": "boolean"
    },
    "phase_number": {
      "type": [
        "integer",
        "null"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": true
    },
    "quality_gates": {
      "type": "object",
      "additionalProperties": true
    },
    "deliverable": {
      "type": "object",
      "required": [
        "type",
        "description"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "code",
            "doc",
            "config",
            "module"
          ]
        },
        "path": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "plan_ref": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic revision of this work order. The authoring gate only permits an Architect/CEO to rewrite a live ACTIVE work order when this value strictly increases."
    },
    "reopened_from": {
      "type": "object",
      "description": "Provenance of an explicit lifecycle reopen of a COMPLETED work order. The completion record it closed out is retained in completion_history.",
      "required": ["revision", "reopened_at", "reopened_by", "reason", "previous_status"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "reopened_at": { "type": "string" },
        "reopened_by": { "type": "string" },
        "reason": { "type": "string" },
        "previous_status": { "type": "string" }
      },
      "additionalProperties": false
    },
    "completion_history": {
      "type": "array",
      "description": "Append-only history of completion records closed out by an explicit reopen; never rewritten in place.",
      "items": {
        "type": "object",
        "required": ["revision", "completed_at", "status"],
        "properties": {
          "revision": { "type": "integer", "minimum": 1 },
          "completed_at": { "type": "string" },
          "status": { "type": "string" },
          "completion": { "type": "object", "additionalProperties": true },
          "reopened_by": { "type": "string" },
          "reopen_reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "evidence_stale": {
      "type": "object",
      "description": "Set by the runtime when an amendment changes a field that prior verification evidence depended on. Bound to the revision that invalidated it; completion must be re-established for that revision. For a dependent whose upstream changed, the historical completion record is preserved and only current evidence is invalidated.",
      "required": ["invalidated_at", "invalidated_by", "revision", "reason", "fields"],
      "properties": {
        "invalidated_at": { "type": "string" },
        "invalidated_by": { "type": "string" },
        "revision": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string" },
        "fields": { "type": "array", "items": { "type": "string" } },
        "dependents": { "type": "array", "items": { "type": "string" } },
        "requires_revalidation": {
          "type": "boolean",
          "description": "True when the current evidence must be re-established before the work order is release-eligible."
        },
        "requires_rework": {
          "type": "boolean",
          "description": "True when the upstream change may require code changes, so re-verification alone cannot clear the marker."
        },
        "revalidation_blocked_reason": {
          "type": "string",
          "description": "Set when archiving found that a recorded upstream advanced again; the marker is retained and revalidation is refused until re-verification against the newer upstream."
        },
        "sources": {
          "type": "array",
          "description": "Append-only provenance of every upstream change that invalidated this evidence.",
          "items": {
            "type": "object",
            "required": ["upstream_work_order", "upstream_revision", "fields", "reason", "invalidated_at"],
            "properties": {
              "upstream_work_order": { "type": "string" },
              "upstream_revision": { "type": "integer", "minimum": 1 },
              "upstream_contract_revision": { "type": ["integer", "null"] },
              "via": { "type": "string" },
              "depth": { "type": "integer", "minimum": 1 },
              "fields": { "type": "array", "items": { "type": "string" } },
              "reason": { "type": "string" },
              "invalidated_at": { "type": "string" },
              "requires_rework": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "revalidation_history": {
      "type": "array",
      "description": "Append-only record of runtime re-verification that cleared a stale-evidence marker on a COMPLETED work order: the workspace's declared build (when it declares one) was executed, the declared test plan was re-executed, and the current deliverable hashes were recorded. Status and completion history are never changed by revalidation.",
      "items": {
        "type": "object",
        "required": ["revalidated_at", "revalidated_by", "revision", "command", "returncode", "artifact_hashes"],
        "properties": {
          "revalidated_at": { "type": "string" },
          "revalidated_by": { "type": "string" },
          "revision": { "type": "integer", "minimum": 1 },
          "contract_revision": { "type": ["integer", "null"], "minimum": 1 },
          "upstream_revisions": { "type": "object", "additionalProperties": true },
          "tests": { "type": "array", "items": { "type": "string" } },
          "command": { "type": "string" },
          "returncode": { "type": "integer" },
          "artifact_hashes": {
            "type": "object",
            "description": "Content hashes of the deliverable files recomputed by the runtime during revalidation.",
            "additionalProperties": { "type": "string" }
          },
          "build": {
            "type": "object",
            "description": "The build the workspace declared at revalidation time, the manifest it ran against, and the artifact hashes it produced. A project that declares a build cannot clear stale evidence without it.",
            "required": ["manifest", "command", "returncode", "artifact_hashes"],
            "properties": {
              "manifest": { "type": "string" },
              "manifest_sha256": { "type": ["string", "null"] },
              "command": { "type": "string" },
              "returncode": { "type": "integer" },
              "artifact_hashes": {
                "type": "object",
                "description": "Content hashes of the deliverables as they stood immediately after the build completed.",
                "additionalProperties": { "type": "string" }
              }
            },
            "additionalProperties": false
          },
          "notes": { "type": "string" },
          "cleared": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": false
      }
    },
    "evidence_revalidated_at": {
      "type": "string",
      "description": "UTC timestamp of the most recent revalidation that cleared a stale-evidence marker."
    },
    "amended_by": {
      "type": "string",
      "description": "Agent that performed the most recent amendment."
    },
    "amended_at": {
      "type": "string",
      "description": "UTC timestamp of the most recent amendment."
    },
    "amendments": {
      "type": "array",
      "description": "Audit trail of Architect amendments; the latest entries are rendered into the worker task contract.",
      "items": {
        "type": "object",
        "required": ["revision", "reason"],
        "properties": {
          "revision": { "type": "integer", "minimum": 1 },
          "agent": { "type": "string" },
          "date": { "type": "string" },
          "reason": { "type": "string" },
          "changed_fields": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "milestone_id": {
      "type": "string",
      "description": "Stable identifier linking this work order to its approved plan milestone (e.g. 'Milestone 1'); primary identity for readiness milestone-coverage validation."
    },
    "test_plan": {
      "type": "array",
      "description": "Explicit mapping of code deliverables to the test artifacts that cover them; honored by the authoring readiness gate and the D024 gate.",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "tests"
        ],
        "additionalProperties": false
      }
    },
    "normalized_by": {
      "type": "string",
      "description": "Provenance marker for deterministic compiler normalization (e.g. 'authoring-compiler/1.0.0'); records system-injected invariants on architect-authored artifacts."
    },
    "synthesized_by": {
      "type": "string",
      "description": "Provenance marker for deterministic scaffolding (e.g. 'bootstrap'); an authorized author may supersede such artifacts."
    },
    "implementation_estimate": {
      "type": "object",
      "description": "Architect-authored estimate of the file footprint of this work order; the contract budget must cover it.",
      "required": [
        "expected_files",
        "max_files_touched"
      ],
      "properties": {
        "expected_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_files_touched": {
          "type": "integer",
          "minimum": 1
        },
        "rationale": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "created": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\{\\{[A-Z0-9_]+\\}\\}$"
        },
        {
          "type": "string"
        }
      ]
    },
    "updated": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\{\\{[A-Z0-9_]+\\}\\}$"
        },
        {
          "type": "string"
        }
      ]
    },
    "completed_at": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\{\\{[A-Z0-9_]+\\}\\}$"
        },
        {
          "type": "string"
        }
      ]
    },
    "unblocked": {
      "type": [
        "string",
        "null"
      ]
    },
    "unblocked_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "type": "string"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files_created": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gate_conditions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "condition": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            },
            "required": [
              "condition",
              "status"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "milestones": {
      "type": "object",
      "patternProperties": {
        "^M[0-9]+$": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "assigned": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "status": {
              "type": "string",
              "enum": [
                "READY",
                "PENDING",
                "ACTIVE",
                "BLOCKED",
                "COMPLETE",
                "COMPLETED",
                "FAILED"
              ]
            },
            "completed_at": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^\\{\\{[A-Z0-9_]+\\}\\}$"
                },
                {
                  "type": "string"
                }
              ]
            },
            "depends_on": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": {
              "type": "string"
            },
            "tasks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "acceptance": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "gate": {
              "type": "boolean"
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "dependency_graph": {
      "type": "string"
    },
    "agent_assignments": {
      "type": "object",
      "additionalProperties": true
    },
    "log": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "date": {
                "type": "string"
              },
              "agent": {
                "type": "string"
              },
              "action": {
                "type": "string"
              }
            },
            "required": [
              "date",
              "agent",
              "action"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "rework_budget": {
      "type": "integer",
      "minimum": 1,
      "default": 2
    },
    "rework_count": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "blocked_by_rework": {
      "type": "boolean",
      "default": false
    },
    "contract_ref": {
      "type": "string"
    },
    "context": {
      "type": [
        "object",
        "string",
        "array"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "deliverables": {
      "type": [
        "array",
        "object"
      ]
    },
    "instructions": {
      "type": [
        "array",
        "string"
      ]
    },
    "milestone": {
      "type": [
        "string",
        "object"
      ]
    },
    "qa_by": {
      "type": "string"
    },
    "qa_verdict": {
      "type": "string"
    }
  },
  "additionalProperties": false
}