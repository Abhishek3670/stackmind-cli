{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StackMind Durable Memory Record",
  "type": "object",
  "required": [
    "memory_id",
    "memory_type",
    "content",
    "normalized_content",
    "project_id",
    "provenance",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "memory_id": {
      "type": "string",
      "pattern": "^MEM-[0-9a-f]{16}$"
    },
    "memory_type": {
      "type": "string",
      "enum": ["fact", "decision", "lesson", "preference", "pattern"]
    },
    "content": {
      "type": "string"
    },
    "normalized_content": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_experience_ids",
        "extraction_method",
        "extracted_at",
        "extractor_agent",
        "confidence"
      ],
      "properties": {
        "source_experience_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "extraction_method": {
          "type": "string",
          "enum": ["manual", "compiler", "llm_distillation"]
        },
        "extracted_at": {
          "type": "string"
        },
        "extractor_agent": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["experience_id", "evidence_type", "excerpt"],
        "properties": {
          "experience_id": { "type": "string" },
          "evidence_type": { "type": "string" },
          "excerpt": { "type": "string" },
          "dimension_scores": {
            "type": "object",
            "additionalProperties": { "type": "boolean" }
          }
        },
        "additionalProperties": true
      }
    },
    "status": {
      "type": "string",
      "enum": ["candidate", "active", "superseded", "expired", "deleted"]
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "last_validated_at": {
      "type": ["string", "null"]
    },
    "expires_at": {
      "type": ["string", "null"]
    },
    "superseded_by": {
      "type": ["string", "null"]
    },
    "supersedes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}