{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Harness Runtime LLM Output",
  "type": "object",
  "required": [
    "status",
    "summary",
    "report_markdown"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "blocked",
        "deferred"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "report_markdown": {
      "type": "string",
      "minLength": 1
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modified_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "release_target": {
      "type": "string"
    },
    "retrieval_queries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
