{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Harness Runtime LLM Output",
  "type": "object",
  "required": [
    "status",
    "summary",
    "report_markdown"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "blocked",
        "deferred"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "report_markdown": {
      "type": "string",
      "minLength": 1
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modified_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "release_target": {
      "type": "string"
    },
    "retrieval_queries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocker_details": {
      "type": "array",
      "description": "Structured blockers for blocked reviews: each carries the finding and the prescribed remediation.",
      "items": {
        "type": "object",
        "required": [
          "finding"
        ],
        "properties": {
          "finding": {
            "type": "string"
          },
          "remediation": {
            "type": "string",
            "description": "Prescribed concrete fix for the finding."
          },
          "path": {
            "type": "string",
            "description": "Deliverable path the finding concerns."
          },
          "work_order": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}